# Copy to .env.local / Vercel. Never commit real secrets.

# ── TTS provider ───────────────────────────────────────────────────────────
# Default: elevenlabs (current subscription).
# When ElevenLabs ends: TTS_PROVIDER=fish
TTS_PROVIDER=elevenlabs

# ElevenLabs — required for STT always; required for TTS while TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# Fish Audio — required only when TTS_PROVIDER=fish
FISH_API_KEY=
# Female voice reference_id from https://fish.audio voice library
FISH_VOICE_ID=
# Optional. Production: s2.1-pro. Eval: s2.1-pro-free ($0, no DPA).
# FISH_TTS_MODEL=s2.1-pro

# ── Failure alerts (optional) ──────────────────────────────────────────────
# FAILURE_ALERT_SLACK_WEBHOOK_URL=
# FAILURE_ALERT_TO=

# ── Founder/company grounding (src namespace) ───────────────────────────────
# Cosine similarity floor for licensing a ContentChunk as [[src]] evidence.
# COMPANY_INFO_SIMILARITY_FLOOR=0.45
#
# FOUNDER DECISION: when true (default), Jazz/Bykea public metrics are withheld
# from model projection and blocked at the ship gate. Set false only after
# Marty/Ali clear surfacing those public figures as Ali-attributed personal facts.
# SUPPRESS_UNCLEARED_CLIENT_METRICS=true
