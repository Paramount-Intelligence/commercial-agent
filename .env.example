# Copy to .env.local (local) or set in Vercel → Settings → Environment Variables.
# Never commit real secrets. Production checklist is at the bottom.

# ── Database (required) ─────────────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# Optional pool tuning for serverless (defaults: limit 5, timeout 20s)
# PRISMA_CONNECTION_LIMIT=5
# PRISMA_POOL_TIMEOUT=20

# ── AI / retrieval (required) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides
# ANTHROPIC_VOICE_MODEL=claude-haiku-4-5
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# ── Auth / org credential encryption (required) ─────────────────────────────
# AUTH_COOKIE_SECRET: ≥32 random characters
AUTH_COOKIE_SECRET=
# ORG_SECRET_KEY: base64 32-byte key — generate with: npx tsx scripts/generate-org-key.ts
ORG_SECRET_KEY=

# ── SMTP / OTP email (required) ─────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="Paramount Intelligence Adviser <adviser@agent.paramountintelligence.co>"

# ── Voice — Fish Audio (required for /voice) ────────────────────────────────
FISH_API_KEY=
# Female voice reference_id from https://fish.audio voice library
FISH_VOICE_ID=
# Production: s2.1-pro (paid, DPA). Local eval only: s2.1-pro-free ($0 TTS; ASR still billed).
FISH_TTS_MODEL=s2.1-pro

# ── Vercel Blob (required on Vercel for durable PDFs / uploads) ─────────────
BLOB_READ_WRITE_TOKEN=

# ── Lead notify / failure alerts (optional) ─────────────────────────────────
# LEAD_NOTIFY_TO=
# FAILURE_ALERT_SLACK_WEBHOOK_URL=
# FAILURE_ALERT_TO=

# ── Founder / company grounding (optional) ──────────────────────────────────
# COMPANY_INFO_SIMILARITY_FLOOR=0.45
# SUPPRESS_UNCLEARED_CLIENT_METRICS=true

# ── Local-only (do NOT set on Vercel) ───────────────────────────────────────
# LEAD_GEO_OVERRIDE=Boston|MA|US
# PUPPETEER_EXECUTABLE_PATH=
# CHROME_PATH=

# ── Staging database (only in .env.staging, never on Vercel) ────────────────
# The db guard allows a remote database outside production only when both match.
# DB_TARGET=staging
# STAGING_DB_FINGERPRINT=   (npm run db:fingerprint)

# ── Seed and eval harness (local only; all paths outside the repo) ──────────
# KNOWLEDGE_DIR=D:\Paramount Intelligence\Knowledge
# EVAL_DIR=D:\Paramount Intelligence\Knowledge\reports
# EVAL_OUT=D:\Paramount Intelligence\Jackie Notes\evals
# EVAL_BASE_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════
# PRODUCTION (Vercel) checklist
# 1. Set every required var above on the production project (commercial-agent).
#    Staging is a separate project (commercial-agent-staging) with its own
#    DATABASE_URL, DIRECT_URL, BLOB_READ_WRITE_TOKEN and secrets.
# 2. FISH_TTS_MODEL=s2.1-pro (not *-free).
# 3. BLOB_READ_WRITE_TOKEN from a Vercel Blob store.
# 4. SMTP_FROM on a verified domain (SPF/DKIM).
# 5. Deploy — build runs `prisma migrate deploy` then `next build`.
# 6. Create an adviser admin: npm run admin:create -- "Name" "email@…"
#    (or use /admin/admins after the first CLI admin exists).
# ═══════════════════════════════════════════════════════════════════════════

# ── Latency debug (optional) ────────────────────────────────────────────────
# TIMING_DEBUG=1 shows timingMs in API responses and allows /voice?debug=1 for
# everyone. Leave unset in production; adviser admins always see it.
# TIMING_DEBUG=

# ── File storage ────────────────────────────────────────────────────────────
# Files are always served through the app (never by their storage URL).
# On Vercel: connect a PRIVATE Blob store with the env prefix BLOB_PRIVATE.
#   Vercel then sets BLOB_PRIVATE_STORE_ID; the app reaches the store with the
#   project's OIDC token (no read-write token exists for private stores).
# Local development: leave these unset; files go to .data/uploads (gitignored).
#   A pulled BLOB_PRIVATE_STORE_ID is ignored off Vercel.
# BLOB_READ_WRITE_TOKEN / BLOB_ACCESS: older public-store setup (fallback).
# CONFIDENTIAL_NAMES=a,b  optional extra names to hide from buyers.
# BLOB_PRIVATE_STORE_ID=
# BLOB_ACCESS=
# CONFIDENTIAL_NAMES=
