# Copy to .env.local / Vercel. Never commit real secrets.

# ── TTS provider ───────────────────────────────────────────────────────────
# Default: elevenlabs (current subscription).
# When ElevenLabs ends: TTS_PROVIDER=fish
TTS_PROVIDER=elevenlabs

# ElevenLabs — required for STT always; required for TTS while TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# Fish Audio — required only when TTS_PROVIDER=fish
FISH_API_KEY=
# Female voice reference_id from https://fish.audio voice library
FISH_VOICE_ID=
# Optional. Production: s2.1-pro. Eval: s2.1-pro-free ($0, no DPA).
# FISH_TTS_MODEL=s2.1-pro

# ── Failure alerts (optional) ──────────────────────────────────────────────
# FAILURE_ALERT_SLACK_WEBHOOK_URL=
# FAILURE_ALERT_TO=
